```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/

# Build and distribution directories
build/
dist/
*.egg-info/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# IDE and editor files
.vscode/
.idea/
*.iml
*.ipr
*.iws

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
htmlcov/
.coverage.*

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# Environment variables
.env
.env.local
*.env.*
```